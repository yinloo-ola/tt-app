package widget

import "fmt"

script toggle(id string) {
	event.stopPropagation();
	const el = htmx.closest(event.target, "#"+id);
	toggleClasses(el, ['hidden','flex']);
	if (el.classList.contains('flex')) {
		console.log('is hidden now');
	}
}

script hide(id string) {
	event.stopPropagation();
	const el = htmx.closest(event.target, "#"+id);
	toggleClasses(el, ['hidden','flex']);
	const childrenToRemove = el.querySelectorAll('pi');
	for (const child of childrenToRemove) {
		el.remove(child);
	}
}

templ ModalOnce(hidden bool, elementID string, body templ.Component) {
	<div
		id={ elementID }
		class={ fmt.Sprintf("fixed inset-0 z-48 flex-col items-center bg-gray-9/50 transition duration-1000 ease-in-out %s", flexOrHidden(hidden)) }
		hx-on:toggle-modal={ toggle(elementID) }
	>
		<div class="-z-1 absolute inset-0" onclick={ hide(elementID) }></div>
		@body
	</div>
}
